 target/linux/lantiq/image/vr9.mk              |  21 +-
 .../xrx200/base-files/etc/board.d/01_leds     |  12 +
 .../xrx200/base-files/etc/board.d/02_network  |   6 +-
 .../xrx200/base-files/lib/upgrade/platform.sh |   1 +
 7 files changed, 742 insertions(+), 3 deletions(-)
